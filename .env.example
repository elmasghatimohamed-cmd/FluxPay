# Copy to .env and replace every CHANGE_ME value before starting Compose.
# Local development only. Never commit .env or use these credentials in production.
POSTGRES_USER=fluxpay_admin
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_PORT=15432
KAFKA_EXTERNAL_PORT=19092

TRANSFER_DB_NAME=transfer_db
TRANSFER_DB_USER=transfer_app
TRANSFER_DB_PASSWORD=CHANGE_ME_TRANSFER_PASSWORD

FINANCE_DB_NAME=finance_db
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=CHANGE_ME_FINANCE_PASSWORD

RISK_DB_NAME=risk_db
RISK_DB_USER=risk_app
RISK_DB_PASSWORD=CHANGE_ME_RISK_PASSWORD

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=CHANGE_ME_NOTIFICATION_PASSWORD
